# Backend Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=5000

# Firebase Service Account
# Option 1: Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# Option 2: Individual values (if not using JSON file)
# FIREBASE_PROJECT_ID=safeguardher-28
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@safeguardher-28.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Web API Key (for REST authentication)
FIREBASE_API_KEY=AIzaSyAbv1Qn-RRW-33cc_goF8762lZmqim7qO0

# Optional: timeout for Firebase network calls in milliseconds
FIREBASE_TIMEOUT_MS=8000

# Optional AI integrations
GROQ_API_KEY=your_groq_api_key_here
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TIMEOUT_MS=15000

# Optional local upload folders
VEHICLE_UPLOAD_DIR=uploads/vehicle-observations

# Journey tracking and route planning
ORS_API_KEY=your_openrouteservice_key_here
DEVIATION_THRESHOLD_METRES=1000

# Optional Twilio delivery for journey SOS
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+1234567890
# EMERGENCY_CONTACT_NUMBER=+919876543210
# POLICE_CONTACT_NUMBER=+91100
