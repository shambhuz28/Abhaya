# Frontend (Expo) environment variables
#
# Note: In Expo, variables intended for the client bundle should be prefixed with EXPO_PUBLIC_.
# Fill these in locally in your own `.env` file (gitignored).

# Backend base URL (without /api)
# Examples:
# - http://192.168.1.10:5000
# - https://your-domain.com
EXPO_PUBLIC_BACKEND_API_URL=http://0.0.0.0:5000

# Cloudinary (optional for evidence upload)
EXPO_PUBLIC_CLOUDINARY_UPLOAD_URL=https://api.cloudinary.com/v1_1/djhoiggsv/video/upload
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=abhaya_upload

# Fast2SMS (backend)
# Add this key in backend/.env (NOT in Expo client bundle).
FAST2SMS_API_KEY=
