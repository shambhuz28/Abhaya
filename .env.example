# Frontend (Expo) environment variables
#
# Note: In Expo, variables intended for the client bundle should be prefixed with EXPO_PUBLIC_.
# Copy this to `.env` (gitignored) and fill in your own values.

# Backend base URL (choose ONE)
# Preferred (includes /api):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:5000/api
EXPO_PUBLIC_API_BASE_URL=

# Alternative (base without /api). The app will append `/api` automatically:
# EXPO_PUBLIC_BACKEND_API_URL=http://192.168.1.10:5000
EXPO_PUBLIC_BACKEND_API_URL=

# Alternative (alias):
EXPO_PUBLIC_BACKEND_URL=

# Cloudinary (optional for SOS evidence upload)
EXPO_PUBLIC_CLOUDINARY_UPLOAD_URL=https://api.cloudinary.com/v1_1/<your-cloud-name>/video/upload
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=<your-upload-preset>

# Legacy / optional (not used by the current app)
FAST2SMS_API_KEY=
